# Walker configuration — NAMES ONLY. Never commit real values.
# Copy to .env (gitignored) and fill in for local runs / the live smoke.

# Required. Shared HMAC key + bearer token. Must be the SAME value Beagle holds
# in its production environment (contract §2, §11). Fail-closed if unset.
DISCOVERY_WORKER_SECRET=

# Required. Beagle's base URL, e.g. https://web-2-app-backend-api.vercel.app
BEAGLE_BASE_URL=

# Optional. Worker identity sent as X-Worker-Id (contract §2). Defaults to "walker-1".
WORKER_ID=walker-1

# Optional. Port the runtime health/readiness server binds to. Railway injects
# PORT automatically; if unset, the worker defaults to 8080. Not required.
PORT=8080

# ---------------------------------------------------------------------------
# HARD BOUNDARY (Walker rules #4, #7; handoff §4): Walker NEVER receives a
# Supabase credential. Do not add any SUPABASE_* variable here or to the
# environment — config.ts refuses to start if one is present.
# ---------------------------------------------------------------------------
