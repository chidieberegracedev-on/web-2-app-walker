{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-2-app-backend-api.vercel.app/contracts/recommendation-payloads/v1.0.0",
  "title": "Beagle AIRecommendation payload contract",
  "description": "Frozen wire contract for the five AIRecommendation types Beagle accepts from Walker and persists. Generated from lib/recommendations/schema.ts — do not hand-edit. This schema expresses what Beagle validates structurally; two rules it enforces in code cannot be expressed in JSON Schema and are stated in x-beagle-additional-rules.",
  "version": "1.0.0",
  "frozen": true,
  "type": "object",
  "required": [
    "type",
    "target",
    "recommendation",
    "confidence",
    "reason",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "navigationItem",
        "homepageSelection",
        "themePreset",
        "nativeScreen",
        "assetSelection"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Per-field confidence 0..1. Stored as-is; the presentation tier (high/medium/low) is DERIVED by Beagle at read time and never sent by Walker."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Human-readable, user-facing. Never a stack trace or raw model output."
    },
    "source": {
      "type": "string",
      "enum": [
        "ai",
        "deterministicFallback"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "navigationItem"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "A discovery page id in the form 'page-N' (1-based index into the submitted discoveryResult.pages[]). Beagle validates only non-emptiness here; an unresolvable id is rejected at accept time."
          },
          "recommendation": {
            "$ref": "#/$defs/navigationItemPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "homepageSelection"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "A discovery page id in the form 'page-N' (1-based index into the submitted discoveryResult.pages[]). Beagle validates only non-emptiness here; an unresolvable id is rejected at accept time."
          },
          "recommendation": {
            "$ref": "#/$defs/homepageSelectionPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "themePreset"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "type": "string",
            "const": "theme"
          },
          "recommendation": {
            "$ref": "#/$defs/themePresetPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "nativeScreen"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "settings",
              "about",
              "support",
              "profile",
              "notifications",
              "onboarding",
              "offlineError"
            ]
          },
          "recommendation": {
            "$ref": "#/$defs/nativeScreenPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "assetSelection"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "type": "string",
            "const": "identity.icon"
          },
          "recommendation": {
            "$ref": "#/$defs/assetSelectionPayload"
          }
        }
      }
    }
  ],
  "$defs": {
    "navigationItemPayload": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "primaryNavigation",
            "secondaryNavigation",
            "contextual",
            "externalLink",
            "hidden"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role",
        "order"
      ]
    },
    "homepageSelectionPayload": {
      "type": "object",
      "properties": {
        "isInitialRoute": {
          "type": "boolean",
          "const": true
        },
        "path": {
          "default": "/",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "isInitialRoute"
      ]
    },
    "themePresetPayload": {
      "type": "object",
      "properties": {
        "templatePreset": {
          "type": "string",
          "enum": [
            "websiteMatch",
            "minimal",
            "modern",
            "commerce",
            "dashboard",
            "professional",
            "soft",
            "compact"
          ]
        },
        "colorTokens": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#([0-9A-F]{3}){1,2}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#([0-9A-F]{3}){1,2}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#([0-9A-F]{3}){1,2}$"
            },
            "onPrimary": {
              "type": "string",
              "pattern": "^#([0-9A-F]{3}){1,2}$"
            }
          },
          "required": [
            "primary",
            "surface",
            "background",
            "onPrimary"
          ]
        }
      },
      "required": [
        "templatePreset",
        "colorTokens"
      ]
    },
    "nativeScreenPayload": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "templateVariant": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "templateVariant"
      ]
    },
    "assetSelectionPayload": {
      "type": "object",
      "properties": {
        "activeAssetRef": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "assetRef": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "sourceType": {
                "type": "string",
                "enum": [
                  "favicon",
                  "manifest",
                  "appleTouchIcon",
                  "openGraph"
                ]
              },
              "rank": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "assetRef",
              "sourceType",
              "rank"
            ]
          }
        }
      },
      "required": [
        "activeAssetRef",
        "candidates"
      ]
    }
  },
  "x-beagle-additional-rules": [
    "target must be valid for the type (isValidTarget): themePreset='theme', assetSelection='identity.icon', nativeScreen ∈ screen-type enum, navigationItem/homepageSelection = non-empty page id.",
    "recommendation payload must match the type-specific schema in $defs (enforced by superRefine).",
    "source 'openai' and any value other than 'ai'|'deterministicFallback' are rejected by both Zod and the ai_recommendations.source DB CHECK.",
    "assetSelection.candidates[].assetRef and activeAssetRef must be Beagle-issued managed asset UUIDs (from the asset-upload endpoint); the worker cannot mint them.",
    "A submission may carry at most 200 recommendations; each reason ≤500 chars."
  ]
}
